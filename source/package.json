{
  "name": "fangpian-recruitment-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "description": "方片人才管理系统及候选人招聘站的原项目还原版",
  "studio": {
    "previewChecks": [
      {
        "path": "/"
      },
      {
        "path": "/方片招聘网站原型.html"
      },
      {
        "path": "/会议室预订原型.html"
      },
      {
        "path": "/demand_rows_generated.js",
        "nonEmpty": true
      },
      {
        "path": "/referral_rows_generated.js",
        "nonEmpty": true
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.server.json",
    "test:contracts": "pnpm run build && node --test tests/*.test.mjs",
    "test:browser": "playwright test -c playwright.config.mjs",
    "start": "node dist/main.js",
    "start:dev": "node --watch-path=server --watch-path=source-app --watch-path=build.mjs server.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/serve-static": "^4.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "cron": "^3.1.7",
    "docx": "^9.5.1",
    "express": "^4.21.0",
    "html-to-image": "^1.11.13",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
