# Published application origin, for example https://your-app.studio.fengbao.com
APP_PUBLIC_URL=

# Enterprise WeCom group robot key used for internal talent review notifications
WECOM_TALENT_REVIEW_WEBHOOK_KEY=
WECOM_TALENT_GROUP_WEBHOOK_KEY=
WECOM_DAILY_RECRUITMENT_WEBHOOK_KEY=
WECOM_DEMAND_REMINDER_WEBHOOK_KEY=
# Enterprise WeCom internal member userid who exclusively approves new demands and positions
WECOM_RECRUITMENT_APPROVER_USER_ID=
# Tianji personal robot endpoint and recipient wechat_id used for direct approval notifications
TIANJI_WEIXIN_USER_MESSAGE_URL=
TIANJI_WEIXIN_BOOK_MEETING_ROOM_URL=
TIANJI_RECRUITMENT_APPROVER_WECHAT_ID=
# Enterprise WeCom Meeting MCP direct endpoint for meeting room availability fallback
WECOM_MEETING_MCP_URL=
# Enterprise WeCom Meeting MCP direct endpoint for meeting room availability fallback
WECOM_MEETING_MCP_URL=

# 八方锦程 API 与管理后台凭据；只允许写入 .env.local
GDBF_API_BASE=
GDBF_ORGAN_ID=
GDBF_PUBLIC_KEY=
GDBF_PRIVATE_KEY=
GDBF_SIGN_SCHEME=
GDBF_USER_NAME=
