# 应用环境变量清单 (值已脱敏, 部署时请按实际填写)
# 来源: 工作区 .env / .env.local 与平台里为应用单独配置的变量, 后者优先。

APP_PUBLIC_URL=******
GDBF_ADMIN_PASSWORD=******
GDBF_ADMIN_USER_NAME=******
GDBF_API_BASE=******
GDBF_ORGAN_ID=******
GDBF_PASSWORD=******
GDBF_PRIVATE_KEY=******
GDBF_PUBLIC_KEY=******
GDBF_SIGN_SCHEME=******
GDBF_USER_EMAIL=******
GDBF_USER_NAME=******
TIANJI_RECRUITMENT_APPROVER_WECHAT_ID=******
TIANJI_WEIXIN_USER_MESSAGE_URL=******
WECOM_DAILY_RECRUITMENT_WEBHOOK_KEY=******
WECOM_MEETING_MCP_URL=******
WECOM_RECRUITMENT_APPROVER_USER_ID=******
WECOM_TALENT_GROUP_WEBHOOK_KEY=******
WECOM_TALENT_REVIEW_WEBHOOK_KEY=******

# 以下变量在平台上由平台自动注入, 离开平台运行时不存在,
# 依赖它们的功能 (平台数据库、平台接口) 需要改造, 见 DEPLOY.md:
# ARP_API_TOKEN=
# ARP_BASE_URL=
# NODE_ENV=
# NODE_OPTIONS=
# PORT=
# STUDIO_APP_ID=
# STUDIO_APP_TOKEN=
# STUDIO_LISTEN_HOST=
# STUDIO_PLATFORM_URL=
# STUDIO_TEABLE_BASE_ID=
